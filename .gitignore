# ===================================================================
# Java & Maven
# ===================================================================
# Compiled class files, build outputs
/target/
*.class
*.jar
*.war

# Log files
*.log
logs/

# Maven temporary files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# ===================================================================
# IDE & System Files
# ===================================================================
# IntelliJ
.idea/
*.iws
*.iml
*.ipr

# Eclipse
.classpath
.project
.settings/

# VS Code
.vscode/
*.code-workspace

# macOS
.DS_Store

# ===================================================================
# JavaMLBugDetective - Project Specific
# ===================================================================
# Generated artifacts from analysis runs
# These should NEVER be committed to the repository.
/repositories/
/reports/
/archive/
*.arff
*.db
*.db-shm
*.db-wal

# Local configuration files containing sensitive data
# DO NOT COMMIT YOUR PERSONAL CONFIGURATION
config.properties

# ===================================================================
# Working Files (local development/research artifacts)
# ===================================================================
/_working_files/

# ===================================================================
# Academic & Analysis Summary Materials
# These are managed outside the main software repository.
# ===================================================================
/paper/
/*_analysis_summary_*/

# Root-level temporary markdown files, but keep README.md
/*.md
!README.md